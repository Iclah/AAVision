// ============================================================
// AAVision — Nextflow configuration
// ============================================================

// ---- Pipeline parameters (override on the command line with --<name>) ----
params {
    // Input
    input            = null          // path to samplesheet.csv (required)
    outdir           = 'results'     // where published outputs go

    // Analysis tuning
    quality          = 90.0          // min alignment coverage % for HQ reads
    min_length       = 0             // min read length filter (0 = off)

    // Taxonomy (optional)
    kraken_db        = null          // path to Kraken2 DB; null = skip taxonomy
    kraken_confidence = 0.05
    bracken_level    = 'S'
    bracken_threshold = 10
    bracken_read_length = null       // Bracken -r; null = use DB maximum

    // Taxonomy resource controls. Memory defaults to 'auto': the TAXONOMY
    // process sizes its request from the Kraken2 DB (.k2d files) + margin,
    // since Kraken2 must load the whole DB into RAM. Override with an explicit
    // value (e.g. '128.GB') to pin it. cpus/time are plain overridable values.
    kraken_memory    = 'auto'
    kraken_cpus      = 8
    kraken_time      = '12.h'

    // Container. Defaults to the published image on GitHub Container Registry.
    // For local development against a locally built image, override with
    //   --container aavision:dev
    // (after `docker build -t aavision:dev -f AAV_analyzer.dockerfile .`).
    container        = 'ghcr.io/iclah/aavision:1.0.0'
}

// ---- Default process settings ----
process {
    // Every process runs in the mega-image by default
    container = params.container

    // Conservative defaults; individual processes override below as we add them
    cpus   = 2
    memory = 4.GB
    time   = 1.h

    // ---- Resource ceiling (opt-in) ----
    // resourceLimits caps every task's resource request to a maximum. If a
    // process requests more than the limit, Nextflow scales the request DOWN to
    // fit instead of failing to schedule.
    //
    // It is COMMENTED OUT by default so the pipeline uses whatever the machine
    // provides — otherwise a low default would silently cap heavy steps (e.g.
    // TAXONOMY sizes its memory to the Kraken2 DB, which can be 100+ GB) and
    // cause out-of-memory failures on capable hardware.
    //
    // Uncomment and set to your machine's ceiling ONLY if you need to constrain
    // usage — e.g. on a laptop or a memory-limited WSL 2 box. Example for a
    // ~16 GB / 8-core WSL 2 setup:
    //
    //   resourceLimits = [ cpus: 8, memory: 14.GB, time: 24.h ]
    //
    // On a large workstation or HPC node, either leave this commented out or set
    // it to the node's real limits, e.g.:
    //
    //   resourceLimits = [ cpus: 32, memory: 256.GB, time: 72.h ]
}

// ---- Execution profiles ----
profiles {

    // Local execution with Docker (development default)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    // Local execution with Singularity/Apptainer (for HPC users)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Bare local execution (tools must be on PATH; no container)
    local {
        docker.enabled      = false
        singularity.enabled = false
    }
}

// ---- Reporting ----
// Nextflow can emit a timeline, execution report, and trace for each run.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

manifest {
    name            = 'aavision'
    author          = 'Icham Lahbib'
    description     = 'Analysis pipeline for AAV sequencing data from Nanopore platforms'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
